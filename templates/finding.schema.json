{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PEF Finding",
  "type": "object",
  "required": [
    "id",
    "category",
    "ruleId",
    "title",
    "severity",
    "verification",
    "evidence",
    "fixStatus"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "'4.x 이름' 형식으로 통일. 예: 4.13 보안"
    },
    "subcategory": {
      "type": "string"
    },
    "ruleId": {
      "type": "string",
      "description": "체크리스트 항목ID (예: SE-02). 체크리스트에 없는 추가 발견은 EXTRA-<영역>-<이름>"
    },
    "ruleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "한 문제가 여러 항목에 걸칠 때 전부 기재"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    },
    "severityAdjustment": {
      "type": "object",
      "required": [
        "from",
        "reason"
      ],
      "properties": {
        "from": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "description": "체크리스트 기본 심각도를 올리거나 내렸을 때 필수"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "verification": {
      "enum": [
        "Confirmed",
        "Suspected",
        "RequiresManualReview",
        "FalsePositive",
        "NotApplicable"
      ]
    },
    "needsLiveCheck": {
      "type": "boolean",
      "description": "라이브 DB/서버/설정 확인이 있어야 확정되면 true"
    },
    "filePath": {
      "type": "string",
      "description": "대표 위치 1곳"
    },
    "line": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "모르면 null"
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filePath": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "filePath"
        ]
      },
      "description": "원인이 여러 파일에 걸칠 때"
    },
    "evidence": {
      "type": "string",
      "description": "시크릿·개인정보 원본값 금지. 마스킹된 발췌만"
    },
    "reproduction": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "recommendedFix": {
      "type": "string"
    },
    "fixRisk": {
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    "fixStatus": {
      "enum": [
        "Open",
        "Planned",
        "InProgress",
        "Fixed",
        "Verified",
        "AcceptedRisk",
        "Reopened"
      ]
    },
    "acceptedBy": {
      "type": "string",
      "description": "fixStatus=AcceptedRisk일 때 승인한 사람과 일시(KST). 에이전트가 단독으로 AcceptedRisk 처리 금지"
    },
    "verificationResult": {
      "enum": [
        "Improved",
        "Unchanged",
        "Regressed",
        "Inconclusive"
      ]
    },
    "firstDetected": {
      "type": "string",
      "format": "date-time",
      "description": "KST(+09:00) ISO 8601. 예: 2026-10-15T14:42:48+09:00"
    },
    "lastDetected": {
      "type": "string",
      "format": "date-time",
      "description": "KST(+09:00) ISO 8601"
    },
    "source": {
      "type": "string",
      "description": "검사기/도구 이름·버전. 수동 점검이면 manual"
    },
    "disposition": {
      "enum": [
        "ActNow",
        "Plan",
        "NoActionNow",
        "NeedsCheck"
      ],
      "description": "처분. ActNow=지금 조치, Plan=계획에 넣기, NoActionNow=당장 신경 안 써도 됨(근거 필수), NeedsCheck=아직 판단 전. Confirmed/Suspected Finding은 NeedsCheck가 남아 있으면 감사 미완결"
    },
    "dispositionReason": {
      "type": "string",
      "description": "왜 그 처분인지 한 줄"
    },
    "dispositionEvidence": {
      "type": "string",
      "description": "NoActionNow 필수. 영향 없음을 *확인한* 근거(검색 명령·결과·확인한 커밋). 추정·기대 금지"
    },
    "recheckWhen": {
      "type": "string",
      "description": "NoActionNow일 때 다시 봐야 하는 조건. 예: next/og를 쓰기 시작할 때, next 버전 변경 시"
    }
  }
}
